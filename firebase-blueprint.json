{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document stored under /users/{userId}",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid"]
    },
    "Note": {
      "title": "Note",
      "description": "User reflection and study note for a specific Ayah",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "surahName": { "type": "string", "maxLength": 100 },
        "ayahId": { "type": "string", "maxLength": 50 },
        "ayahNumber": { "type": "number" },
        "text": { "type": "string", "maxLength": 5000 },
        "userId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["surahName", "ayahId", "text", "userId"]
    },
    "SurahProgress": {
      "title": "SurahProgress",
      "description": "Accumulated study time and progress for a Surah",
      "type": "object",
      "properties": {
        "surahName": { "type": "string", "maxLength": 100 },
        "totalSeconds": { "type": "number" },
        "readPercent": { "type": "number" },
        "analyzedWordsCount": { "type": "number" },
        "userId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["surahName", "totalSeconds", "userId"]
    },
    "VideoExplanation": {
      "title": "VideoExplanation",
      "description": "Video explanation mapped to a Surah and Ayah",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "surahId": { "type": "number" },
        "ayahNumber": { "type": "number" },
        "youtubeId": { "type": "string", "maxLength": 100 },
        "startTime": { "type": "number" },
        "title": { "type": "string", "maxLength": 300 },
        "scholar": { "type": "string", "maxLength": 150 }
      },
      "required": ["id", "surahId", "ayahNumber", "youtubeId", "title", "scholar"]
    },
    "SurahAudio": {
      "title": "SurahAudio",
      "description": "YouTube Audio ID mapping per Surah",
      "type": "object",
      "properties": {
        "surahId": { "type": "number" },
        "youtubeId": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["surahId"]
    },
    "SurahSync": {
      "title": "SurahSync",
      "description": "Ayah and Word precise sync timing array for a Surah",
      "type": "object",
      "properties": {
        "surahId": { "type": "number" },
        "ayahsJson": { "type": "string", "maxLength": 500000 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["surahId", "ayahsJson"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Public profile of an authenticated user"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "Note",
      "description": "Collection of Ayah notes created by the user"
    },
    "/users/{userId}/progress/{surahName}": {
      "schema": "SurahProgress",
      "description": "Per-surah study progress and session time tracking"
    },
    "/videos/{videoId}": {
      "schema": "VideoExplanation",
      "description": "Public repository of video explanations for Ayahs"
    },
    "/surahAudios/{surahId}": {
      "schema": "SurahAudio",
      "description": "Public map of YouTube Audio IDs per Surah"
    },
    "/surahSyncs/{surahId}": {
      "schema": "SurahSync",
      "description": "Public map of Ayah timing sync data per Surah"
    }
  }
}

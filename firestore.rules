rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile rule
    match /users/{userId} {
      allow get, set, update, delete: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      // Notes subcollection
      match /notes/{noteId} {
        allow read, write: if isOwner(userId) && isValidId(noteId);
      }

      // Progress subcollection
      match /progress/{surahName} {
        allow read, write: if isOwner(userId);
      }
    }

    // Videos collection (Public read, write if signed in)
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(videoId);
    }

    // Surah Audio IDs collection (Public read, write if signed in)
    match /surahAudios/{surahId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(surahId);
    }

    // Surah Sync Data collection (Public read, write if signed in)
    match /surahSyncs/{surahId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(surahId);
    }
  }
}
